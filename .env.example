# 請勿留空；若為空或不是合法 http(s) URL，網站會退回預設網域
NEXT_PUBLIC_SITE_URL=https://www.pinshiacademy.com

# WordPress (WPGraphQL)
WP_GRAPHQL_URL=https://blog.pinshiacademy.com/graphql

# WordPress 發布後即時更新學習專欄（POST/GET /api/revalidate?secret=...）
# 在 Vercel 設為隨機長字串；WP 可用 Webhooks 外掛指向此 URL
REVALIDATE_SECRET=your_random_secret_here

# Google Analytics 4（可選；填了才會載入 gtag）
NEXT_PUBLIC_GA4_ID=G-CKT21WVCLP

# WordPress GraphQL 失敗退回 MDX 時的 webhook 告警（可選；Slack/Discord incoming webhook）
# WP_FALLBACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Google Search Console：HTML 標記驗證（可選；填了才會輸出 meta verification）
# 建議用 NEXT_PUBLIC_ 版本，讓本機/Preview 也能一致驗證（token 本身不是秘密）
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_token_here

